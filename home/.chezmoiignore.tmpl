# Generated by the APM installer; preserve it in the exact conf.d directory.
.config/fish/conf.d/apm.fish

# Generated locally after Android CLI upgrades; preserve the installed version.
.config/fish/completions/android.fish

# Codex runtime configuration, backups, and machine overrides stay local.
.codex/config.toml
.codex/settings-sync-backups/**
.config/codex-settings/settings.local.toml

# macOS-only
{{- if ne .chezmoi.os "darwin" }}
.config/fish/completions/orchard.fish
.config/orchard/**
.local/bin/orchard
Library/LaunchAgents/me.omico.environment.plist
Library/Rime
{{- end }}

# Linux-only
{{- if ne .chezmoi.os "linux" }}
.config/environment.d/60-dotfiles.conf
.config/systemd/user/codex-remote-control.service
.local/share/fcitx5/rime
{{- end }}
