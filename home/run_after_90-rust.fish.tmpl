{{ if has .chezmoi.os (list "darwin" "linux") -}}
#!/usr/bin/env fish

rustup toolchain install stable; or exit $status
fish_add_path --path "$HOME/.cargo/bin"
rustup update; or exit $status
command -q rustc; or begin
    echo "Error: rustc is unavailable after updating Rust." >&2
    exit 1
end

set -l rust_version (rustc --version); or exit $status
echo "Using Rust "(set_color cyan)(string split -f2 ' ' -- "$rust_version")(set_color normal)

if not command -q sccache
    # Disable the configured wrapper while bootstrapping sccache itself.
    env RUSTC_WRAPPER= RUSTC_WORKSPACE_WRAPPER= cargo install sccache; or exit $status
end
sccache --version; or exit $status

exit 0
{{ end -}}
