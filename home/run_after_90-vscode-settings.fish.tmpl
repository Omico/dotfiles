{{ if has .chezmoi.os (list "darwin" "linux") -}}
#!/usr/bin/env fish

set -l settings_dir {{ joinPath .chezmoi.sourceDir ".." "app-settings" | clean | replace "\\" "\\\\" | replace "'" "\\'" | squote }}
source "$settings_dir/apply.fish"; or exit $status
__app_settings_apply_vscode "$settings_dir/vscode-based" {{ .chezmoi.os | quote }}; or exit $status
{{ end -}}
