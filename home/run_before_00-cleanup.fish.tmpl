#!/usr/bin/env fish

set -l cleanup_targets \
    ~/.config/fish/{conf.d,functions}/ \
    ~/.config/ghostty/ \
    ~/.config/orchard/

for target in $cleanup_targets
    test -e "$target"; or test -L "$target"; or continue

    set -l unmanaged_paths (chezmoi unmanaged --path-style absolute --nul-path-separator "$target" | string split0)
    set -l scan_status $pipestatus[1]
    test $scan_status -eq 0; or exit $scan_status

    for path in $unmanaged_paths
        rm -rf -- "$path"; or exit $status
    end
end
