{{ if has .chezmoi.os (list "darwin" "linux") -}}
#!/usr/bin/env fish

set -l fish_path (command -s fish); or exit $status
set -l user (id -un); or exit $status
if test -f /etc/shells; and not contains -- "$fish_path" (cat /etc/shells)
    printf '%s\n' "$fish_path" | sudo tee -a /etc/shells; or exit $status
end
sudo chsh -s "$fish_path" "$user"; or exit $status
{{ end -}}
