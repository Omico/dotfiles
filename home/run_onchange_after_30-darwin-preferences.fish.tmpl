{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env fish
# Settings helper SHA-256: {{ include (joinPath .chezmoi.sourceDir "../macos/close-system-settings.applescript") | sha256sum }}

set -l user_id (id -u); or exit $status
if launchctl print "gui/$user_id" >/dev/null 2>&1
    osascript {{ joinPath .chezmoi.sourceDir "../macos/close-system-settings.applescript" | replace "\\" "\\\\" | replace "'" "\\'" | squote }}; or exit $status
end

# Finder
defaults write com.apple.finder QuitMenuItem -bool true; or exit $status
defaults write com.apple.finder AppleShowAllFiles -bool true; or exit $status
defaults write NSGlobalDomain AppleShowAllExtensions -bool true; or exit $status
defaults write com.apple.finder ShowStatusBar -bool true; or exit $status
defaults write com.apple.finder ShowPathbar -bool true; or exit $status
defaults write com.apple.finder _FXSortFoldersFirst -bool true; or exit $status
defaults write com.apple.finder FXDefaultSearchScope -string SCcf; or exit $status
defaults write com.apple.finder FXEnableExtensionChangeWarning -bool false; or exit $status
defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true; or exit $status
defaults write com.apple.desktopservices DSDontWriteUSBStores -bool true; or exit $status

# Dock
set -l vmm_present (sysctl -n kern.hv_vmm_present); or exit $status
set -l dock_autohide true
test "$vmm_present" = 1; and set dock_autohide false
defaults write com.apple.dock tilesize -int 48; or exit $status
defaults write com.apple.dock autohide -bool $dock_autohide; or exit $status
defaults write com.apple.dock show-recents -bool false; or exit $status
if pgrep -u "$user_id" -x Dock >/dev/null
    pkill -u "$user_id" -x Dock; or exit $status
else
    set -l dock_status $status
    test $dock_status -eq 1; or exit $dock_status
end

# Automatic updates
defaults write com.apple.SoftwareUpdate AutomaticCheckEnabled -bool true; or exit $status
defaults write com.apple.commerce AutoUpdate -bool true; or exit $status

# Mouse
defaults write -g com.apple.swipescrolldirection -bool false; or exit $status
defaults write -g com.apple.mouse.linear 1; or exit $status
defaults write -g com.apple.mouse.scaling 1; or exit $status
{{ end -}}
