{{ if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
#!/usr/bin/env fish

# Regenerate when the generator or installed CLI changes.
# Generator SHA-256: {{ include (joinPath .chezmoi.sourceDir "../scripts/android-fish-completions.py") | sha256sum }}
# Probe through Fish so version detection uses the generation PATH.
# CLI version SHA-256: {{ output "fish" "-c" "if command -q android; command android --version; end" | sha256sum }}

command -q android; or exit 0

if not command -q uv
    echo 'uv is required to generate Android completions.' >&2
    exit 127
end

set -l generator "$CHEZMOI_SOURCE_DIR/../scripts/android-fish-completions.py"
set -l target "$__fish_config_dir/completions/android.fish"

command uv run --quiet --no-project \
    --managed-python --no-python-downloads --python 3.13 \
    --script "$generator" \
    --android (command -s android) \
    --output "$target"
or exit $status
{{ end -}}
