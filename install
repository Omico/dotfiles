#!/bin/bash
set -e
set -o pipefail

if [ "$EUID" -eq 0 ]; then
  echo "Run this installer as your regular user, without sudo. It uses sudo when needed." >&2
  exit 1
fi

trap 'echo "Error: install failed at line $LINENO (last command: $BASH_COMMAND)" >&2; exit 1' ERR

# Supports native Apple Silicon macOS and Ubuntu 24.04; others yield unknown.
function detect-platform {
  case "$(uname)" in
    Darwin)
      if [ "$(uname -m)" = arm64 ]; then
        echo "darwin"
      else
        echo "unknown"
      fi
      ;;
    Linux)
      [ -f /etc/os-release ] || {
        echo "unknown"
        return
      }
      local id version_id
      # shellcheck disable=SC1091
      id=$(. /etc/os-release 2>/dev/null && echo "${ID:-}")
      # shellcheck disable=SC1091
      version_id=$(. /etc/os-release 2>/dev/null && echo "${VERSION_ID:-}")
      if [ "$id" = "ubuntu" ] && [ "$version_id" = "24.04" ]; then
        echo "ubuntu-24.04"
      else
        echo "unknown"
      fi
      ;;
    *) echo "unknown" ;;
  esac
}

platform=$(detect-platform)
if [ "$platform" = unknown ]; then
  echo "This install script only supports native Apple Silicon macOS (arm64) and Ubuntu 24.04. Current: $(uname -sm)" >&2
  exit 1
fi

sudo -v
while true; do
  sudo -n true
  sleep 60
  kill -0 "$$" || exit
done 2>/dev/null &
sudo_keepalive_pid=$!
trap 'kill "$sudo_keepalive_pid" 2>/dev/null || true' EXIT

case "$platform" in
  darwin)
    if ! command -v brew >/dev/null 2>&1; then
      if [ ! -x /opt/homebrew/bin/brew ]; then
        NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
      fi
      eval "$(/opt/homebrew/bin/brew shellenv)"
    fi
    brew install chezmoi fish git
    ;;
  ubuntu-24.04)
    sudo apt update -o APT::Update::Error-Mode=any
    sudo apt install -y curl git gpg software-properties-common
    sudo add-apt-repository -y ppa:fish-shell/release-4
    sudo apt update -o APT::Update::Error-Mode=any
    sudo apt install -y fish
    if ! command -v chezmoi >/dev/null 2>&1; then
      sudo snap install chezmoi --classic
    fi
    ;;
esac

chezmoi init Omico --depth 1 --force
chezmoi apply
